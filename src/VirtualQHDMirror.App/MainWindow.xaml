<Window x:Class="VirtualQHDMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VirtualQHDMirror"
        Width="980"
        Height="620"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="VirtualQHDMirror" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="DimGray"
                           Text="v0.20 display preflight" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Width="110"
                    Height="32"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Click="RefreshDisplays_Click"
                    Content="Refresh" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Virtual source" />
                    <TextBlock x:Name="VirtualSummaryText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="24,0,0,0">
                    <TextBlock FontWeight="SemiBold"
                               Text="Physical destination" />
                    <TextBlock x:Name="PhysicalSummaryText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,18,0,8"
                   FontWeight="SemiBold"
                   Text="Active display paths" />

        <ListView x:Name="DisplayList"
                  Grid.Row="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="190"
                                    Header="Name"
                                    DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Width="85"
                                    Header="Kind"
                                    DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Width="110"
                                    Header="Resolution"
                                    DisplayMemberBinding="{Binding Resolution}" />
                    <GridViewColumn Width="145"
                                    Header="Connector"
                                    DisplayMemberBinding="{Binding Connector}" />
                    <GridViewColumn Width="100"
                                    Header="Source"
                                    DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Width="270"
                                    Header="Why"
                                    DisplayMemberBinding="{Binding Reason}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="4"
                Margin="0,14,0,0"
                Padding="12"
                Background="#F5F5F5"
                CornerRadius="4">
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
