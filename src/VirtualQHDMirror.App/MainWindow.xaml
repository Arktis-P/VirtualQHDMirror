<Window x:Class="VirtualQHDMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VirtualQHDMirror"
        Width="1040"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="VirtualQHDMirror" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="DimGray"
                           Text="v0.20 display setup + stable mirror bridge" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    DockPanel.Dock="Right"
                    Width="110"
                    Height="32"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Click="RefreshDisplays_Click"
                    Content="Refresh" />
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="14"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Detected virtual source" />
                    <TextBlock x:Name="VirtualSummaryText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="24,0,0,0">
                    <TextBlock FontWeight="SemiBold"
                               Text="Detected physical destination" />
                    <TextBlock x:Name="PhysicalSummaryText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="24,0,0,0">
                    <TextBlock FontWeight="SemiBold"
                               Text="Virtual display driver" />
                    <TextBlock x:Name="DriverSummaryText"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="14"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Virtual QHD source" />
                    <ComboBox x:Name="VirtualSourceComboBox"
                              Height="30"
                              Margin="0,7,12,0"
                              DisplayMemberPath="Label"
                              SelectionChanged="PairSelection_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold"
                               Text="Physical FHD destination" />
                    <ComboBox x:Name="PhysicalDestinationComboBox"
                              Height="30"
                              Margin="0,7,12,0"
                              DisplayMemberPath="Label"
                              SelectionChanged="PairSelection_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Button x:Name="StartMirrorButton"
                            Height="32"
                            IsEnabled="False"
                            Click="StartMirror_Click"
                            Content="Start Mirror" />
                    <Button x:Name="StopMirrorButton"
                            Height="32"
                            Margin="0,8,0,0"
                            IsEnabled="False"
                            Click="StopMirror_Click"
                            Content="Stop Mirror" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,18,0,8"
                   FontWeight="SemiBold"
                   Text="Active display paths" />

        <ListView x:Name="DisplayList"
                  Grid.Row="4">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="190"
                                    Header="Name"
                                    DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Width="85"
                                    Header="Kind"
                                    DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Width="110"
                                    Header="Resolution"
                                    DisplayMemberBinding="{Binding Resolution}" />
                    <GridViewColumn Width="95"
                                    Header="Placement"
                                    DisplayMemberBinding="{Binding Placement}" />
                    <GridViewColumn Width="130"
                                    Header="Connector"
                                    DisplayMemberBinding="{Binding Connector}" />
                    <GridViewColumn Width="105"
                                    Header="Source"
                                    DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Width="230"
                                    Header="Why"
                                    DisplayMemberBinding="{Binding Reason}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="5"
                Margin="0,14,0,0"
                Padding="12"
                Background="#F5F5F5"
                CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="MirrorStateText"
                           FontWeight="SemiBold"
                           Text="Mirror is not running." />
                <TextBlock x:Name="StatusText"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
